---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BricsGame from '../../components/BricsGame.astro';
import WeeklyNews from '../../components/WeeklyNews.astro';
---

<BaseLayout
  title="BRICS Markets & Currencies | Stock Exchanges, Forex Rates & Top Companies"
  description="Real-time insights on BRICS stock exchanges, currency exchange rates, forex trends, and top-performing companies across Brazil, Russia, India, China, South Africa, and new BRICS members."
  lang="en"
>
  <Fragment slot="logo">BRICS Markets</Fragment>
  <Fragment slot="footer-name">BRICS Markets & Currencies</Fragment>

  <section class="bb-hero">
    <div class="bb-hero-bg"></div>
    <div class="bb-hero-overlay"></div>
    <div class="bb-hero-content">
      <h1 class="bb-title">BRICS Markets & Currencies</h1>
      <p class="bb-tagline">Real-time insights on BRICS stock exchanges, forex rates, and top-performing companies</p>
      <p class="bb-lead">Track emerging market opportunities across the world's fastest-growing economies. From the Bombay Stock Exchange to the Shanghai Composite, from the real to the ruble — your gateway to BRICS financial intelligence.</p>
    </div>
  </section>

  <div class="ad-slot">Ad Space - Google AdSense</div>

  <div class="card-grid">
    <article class="card">
      <h2>BRICS Stock Exchanges</h2>
      <p>Comprehensive coverage of BSE and NSE in India, Shanghai and Shenzhen exchanges in China, B3 in Brazil, MOEX in Russia, and the JSE in South Africa. Live indices, trading volumes, and market cap analysis.</p>
    </article>
    <article class="card">
      <h2>Currency Exchange Rates</h2>
      <p>Real-time forex tracking for CNY, INR, BRL, RUB, ZAR, EGP, and AED. Cross-currency pair analysis, historical trends, and central bank policy impact on BRICS exchange rates.</p>
    </article>
    <article class="card">
      <h2>Top Growing Companies</h2>
      <p>Discover the fastest-growing public companies across BRICS nations. Sector-by-sector analysis covering tech, energy, finance, and manufacturing leaders driving emerging market growth.</p>
    </article>
    <article class="card">
      <h2>BRICS Currency Index</h2>
      <p>Tracking the proposed BRICS common currency and de-dollarization progress. Analysis of bilateral currency swap agreements and the shift away from USD-denominated trade.</p>
    </article>
    <article class="card">
      <h2>Commodities & Resources</h2>
      <p>Oil, gold, rare earths, and agriculture — how BRICS nations dominate global commodity markets. Price tracking, supply chain analysis, and resource-driven investment opportunities.</p>
    </article>
    <article class="card">
      <h2>Investment Opportunities</h2>
      <p>ETFs, ADRs, and direct investment routes into BRICS markets for international investors. Regulatory guides, risk assessment, and portfolio strategies for emerging market exposure.</p>
    </article>
  </div>

  <div class="ad-slot">Ad Space - Google AdSense</div>

  <BricsGame lang="en" />

  <div class="ad-slot">Ad Space</div>

  <WeeklyNews lang="en" />

  <div class="ad-slot">Ad Space</div>
</BaseLayout>

<style>
  .bb-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin: -40px -20px 0;
    padding: 0;
  }
  .bb-hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('/images/bricsbrother.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .bb-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0,0,0,.55) 0%,
      rgba(0,0,0,.7) 50%,
      rgba(0,0,0,.85) 100%
    );
  }
  .bb-hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 800px;
    padding: 40px 24px;
  }
  .bb-title {
    font-size: 4rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 20px;
    text-shadow: 0 4px 20px rgba(0,0,0,.5);
    letter-spacing: -.02em;
    line-height: 1.1;
  }
  .bb-tagline {
    font-size: 1.5rem;
    font-weight: 600;
    color: rgba(255,255,255,.95);
    margin-bottom: 16px;
    text-shadow: 0 2px 10px rgba(0,0,0,.4);
  }
  .bb-lead {
    font-size: 1.15rem;
    color: rgba(255,255,255,.8);
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto;
    text-shadow: 0 1px 6px rgba(0,0,0,.3);
  }
  @media (max-width: 640px) {
    .bb-title { font-size: 2.4rem; }
    .bb-tagline { font-size: 1.1rem; }
    .bb-lead { font-size: 1rem; }
  }
</style>
