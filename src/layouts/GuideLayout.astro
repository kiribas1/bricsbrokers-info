---
import BaseLayout from './BaseLayout.astro';

export interface GuideMeta {
  slug: string;
  title: string;
  description: string;
  section: string;
  publishedDate: string;
  modifiedDate: string;
  paragraphs: string[];
  bullets: { label: string; text: string }[];
  faq: { q: string; a: string }[];
  related: string[];
}

export interface LangLabels {
  keyFacts: string;
  faq: string;
  related: string;
  backHome: string;
  sections: Record<string, string>;
}

interface Props {
  guide: GuideMeta;
  lang: string;
  allGuides: GuideMeta[];
  labels: LangLabels;
}

const { guide, lang, allGuides, labels } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';
const canonical = `${siteUrl}/${lang}/${guide.slug}/`;
const homePath = `/${lang}/`;

const sectionLabel = labels.sections[guide.section] || guide.section;
const titleFor = (slug: string) => {
  const g = allGuides.find((x) => x.slug === slug);
  return g ? g.title : slug;
};
---

<BaseLayout
  title={`${guide.title} | BRICS Markets`}
  description={guide.description}
  lang={lang}
  type="article"
  publishedDate={guide.publishedDate}
  modifiedDate={guide.modifiedDate}
  section={sectionLabel}
  canonicalUrl={canonical}
>
  <Fragment slot="logo">BRICS Markets</Fragment>
  <Fragment slot="footer-name">BRICS Markets &amp; Currencies</Fragment>

  <article class="guide">
    <header class="guide-head">
      <p class="guide-kicker">{sectionLabel}</p>
      <h1 class="guide-h1">{guide.title}</h1>
      <p class="guide-lead">{guide.description}</p>
      <p class="guide-meta">📅 {guide.modifiedDate}</p>
    </header>

    {guide.paragraphs.map((p: string) => <p class="guide-p">{p}</p>)}

    <div class="ad-slot">Ad Space</div>

    {guide.bullets.length > 0 && (
      <section class="guide-facts">
        <h2>{labels.keyFacts}</h2>
        <ul>
          {guide.bullets.map((b) => <li><strong>{b.label}:</strong> {b.text}</li>)}
        </ul>
      </section>
    )}

    {guide.faq.length > 0 && (
      <section class="guide-faq">
        <h2>{labels.faq}</h2>
        {guide.faq.map((f) => (
          <div class="faq-item">
            <h3 class="faq-q">{f.q}</h3>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </section>
    )}

    {guide.related.length > 0 && (
      <nav class="guide-related">
        <h2>{labels.related}</h2>
        <ul>
          {guide.related.map((slug) => (
            <li><a href={`/${lang}/${slug}/`}>{titleFor(slug)}</a></li>
          ))}
        </ul>
      </nav>
    )}

    <a class="back-home" href={homePath}>{labels.backHome}</a>
  </article>
</BaseLayout>

<style>
  .guide { max-width: 780px; margin: 0 auto; }
  .guide-head { margin-bottom: 24px; }
  .guide-kicker {
    color: #f59e0b; font-weight: 700; font-size: .8rem;
    text-transform: uppercase; letter-spacing: .12em; margin-bottom: 6px;
  }
  .guide-h1 { color: #fff; font-size: 1.9rem; line-height: 1.15; margin-bottom: 12px; }
  .guide-lead { color: rgba(255,255,255,.7); font-size: 1.1rem; line-height: 1.6; margin-bottom: 8px; }
  .guide-meta { color: rgba(255,255,255,.4); font-size: .8rem; }
  .guide-p { color: #d0d0d0; margin: 18px 0; font-size: 1.02rem; line-height: 1.7; }
  .guide-facts, .guide-faq, .guide-related {
    background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.07);
    border-radius: 12px; padding: 20px; margin: 26px 0;
  }
  .guide-facts h2, .guide-faq h2, .guide-related h2 {
    color: #fff; font-size: 1.2rem; margin-bottom: 12px;
  }
  .guide-facts ul, .guide-related ul { list-style: none; padding: 0; }
  .guide-facts li { padding: 6px 0; color: #d0d0d0; }
  .faq-item { padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,.06); }
  .faq-item:last-child { border-bottom: 0; }
  .faq-q { color: #fff; font-weight: 600; margin-bottom: 4px; }
  .faq-a { color: #d0d0d0; margin: 0; }
  .back-home { display: inline-block; margin-top: 20px; color: #6ba3d6; }
</style>